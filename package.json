{
    "name": "niuqiqi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --import tsx server/index.ts",
    "test": "node --import tsx tests/run.ts",
    "test:coverage": "c8 node --import tsx tests/run.ts",
    "test:browser": "node tests/browser.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "c8": {
    "all": true,
    "src": ["web/src", "server", "shared"],
    "include": ["web/src/**/*.{ts,js}", "server/**/*.ts", "shared/**/*.ts"],
    "exclude": ["**/*.test.ts", "web/src/scene/types.ts"],
    "reporter": ["text", "html", "json-summary", "lcov"],
    "reports-dir": "coverage"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "opus-decoder": "^0.7.12",
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "c8": "^12.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
